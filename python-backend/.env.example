# ==========================================
# TAN RSS Backend Configuration
# ==========================================

# Database
# If left empty, SQLite will be used by default (sqlite+aiosqlite:///data/rss.db)
# DB_URL="postgresql+asyncpg://user:password@localhost/tan_rss"
DB_URL=""

# Redis (Used by Celery for background tasks)
REDIS_URL="redis://localhost:6379/0"

# Vector Database (Milvus)
MILVUS_HOST="10.110.3.25"
MILVUS_PORT="19530"
MILVUS_COLLECTION="rss_entries"

# Default AI Services (Aurora AI / OpenAI Compatible)
AURORA_AI_API_KEY=""
AURORA_AI_BASE_URL="http://10.110.3.61:9997/v1"
AURORA_AI_MODEL="qwen3"
AURORA_AI_EMBEDDING_BASE_URL="http://10.110.3.61:9997/v1"
AURORA_AI_EMBEDDING_MODEL="Qwen3-Embedding-0.6B"

# Backend Server
HOST="0.0.0.0"
PORT="27496"
